# WordPress source site (REST API base URL — must NOT be the same domain as the
# Vercel/Next.js deployment or requests will loop back to Vercel and be blocked).
#
# If fenadaily.com is your Next.js site on Vercel, WordPress must live at a
# different URL, for example:
#   https://cms.fenadaily.com          ← subdomain pointing to WP hosting
#   https://fenadaily.wpengine.com     ← managed WP host staging URL
#   https://<server-ip>                ← direct hosting server IP
#
# After changing this, redeploy on Vercel. Test connectivity at /api/wp-status.
WORDPRESS_URL=https://cms.fenadaily.com

# Public site URL (used for OG tags, sitemap, canonical URLs, unsubscribe links).
# www.<domain> is the canonical production domain — Vercel's domain settings
# redirect the apex (fenadaily.com) to www, so this must be the www URL or
# every canonical tag/sitemap entry would point at a URL that redirects away
# from itself.
NEXT_PUBLIC_SITE_URL=https://www.fenadaily.com

# ── Resend ────────────────────────────────────────────────────────────────────
# Required — get your key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — Resend Audience UUID for storing subscribers
# Found in the Resend dashboard URL: resend.com/audiences/<THIS-UUID>
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional — sender address once fenadaily.com is verified in Resend
# Format must be: Display Name <address@fenadaily.com>
# Leave unset to use the default Resend shared address (onboarding@resend.dev)
RESEND_FROM_EMAIL=Fena Daily <newsletter@fenadaily.com>

# ── Unsubscribe ───────────────────────────────────────────────────────────────
# Secret used to sign unsubscribe tokens — generate with: openssl rand -hex 32
# REQUIRED in production — without it, unsubscribe tokens fall back to a
# predictable value and can be forged.
UNSUBSCRIBE_SECRET=replace-with-a-long-random-string

# ── Diagnostics ───────────────────────────────────────────────────────────────
# Optional — protects /api/wp-status from public access. Without this set,
# the endpoint returns 404 to everyone (including the operator). Generate
# with: openssl rand -hex 32, then visit /api/wp-status?key=<value>
WP_STATUS_SECRET=
